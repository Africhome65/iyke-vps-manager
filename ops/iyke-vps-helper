#!/usr/bin/env python3
"""Strict JSON privileged helper. Installed root-owned; invoked through one fixed sudo command."""
import datetime
import fcntl
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from contextlib import contextmanager

NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,30}\$?$")
SYSTEM_UID_MIN = 1000
MAX_REQUEST_BYTES = 8192
STATE_DIR = "/var/lib/iyke-vps-manager-state"


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def run(argv, input_text=None):
    try:
        result = subprocess.run(argv, input=input_text, text=True, capture_output=True,
                                check=False, timeout=30)
    except subprocess.TimeoutExpired:
        fail("System command timed out")
    if result.returncode:
        fail(result.stderr.strip() or "System command failed")
    return result.stdout.strip()


def state_path(name):
    return os.path.join(STATE_DIR, name)


def check_state_dir():
    try:
        info = os.lstat(STATE_DIR)
    except OSError:
        fail("Managed-account state directory is unavailable")
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) & 0o077):
        fail("Managed-account state directory has unsafe ownership or permissions")


@contextmanager
def registry_lock():
    check_state_dir()
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(state_path("managed-users.lock"), flags, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            os.close(fd)
            fail("Managed-account lock file is unsafe")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "r+") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            yield
    except OSError:
        fail("Unable to lock managed-account registry")


def load_registry():
    check_state_dir()
    path = state_path("managed-users.json")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return {}
    except OSError:
        fail("Unable to open managed-account registry")
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            fail("Managed-account registry file is unsafe")
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            data = json.load(source)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("Managed-account registry is unreadable or corrupted")
    finally:
        if fd >= 0:
            os.close(fd)
    if (not isinstance(data, list) or any(
            not isinstance(name, str) or not NAME.fullmatch(name)
            or name in {"root", "nobody"} for name in data
    ) or len(data) != len(set(data))):
        fail("Managed-account registry contains invalid data")
    return set(data)


def save_registry(names):
    check_state_dir()
    if (not isinstance(names, dict) or any(
            not isinstance(name, str) or not NAME.fullmatch(name)
            or isinstance(uid, bool) or not isinstance(uid, int) or uid < SYSTEM_UID_MIN
            for name, uid in names.items()
    )):
        fail("Refusing to save invalid managed-account data")
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".managed-users-", dir=STATE_DIR)
        os.fchmod(fd, 0o600)
        os.fchown(fd, os.geteuid(), os.getegid())
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            json.dump({name: names[name] for name in sorted(names)}, target, separators=(",", ":"))
            target.write("\n")
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, state_path("managed-users.json"))
        temporary = None
        directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        fail("Unable to update managed-account registry")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def valid_name(value, must_exist=False):
    if not isinstance(value, str) or not NAME.fullmatch(value) or value in {"root", "nobody"}:
        fail("Invalid or protected username")
    if must_exist:
        try:
            uid = int(run(["id", "-u", value]))
        except (ValueError, SystemExit):
            fail("User account does not exist")
        if uid < SYSTEM_UID_MIN:
            fail("Refusing to modify a system account")
    return value


def valid_expiry(value):
    if not isinstance(value, str):
        fail("Expiry must use YYYY-MM-DD")
    try:
        parsed = datetime.date.fromisoformat(value)
        if parsed <= datetime.date.today():
            fail("Expiry must be in the future")
    except ValueError:
        fail("Expiry must use YYYY-MM-DD")
    return value


def account_exists(name):
    try:
        result = subprocess.run(["getent", "passwd", name], text=True, capture_output=True,
                                check=False, timeout=10)
    except subprocess.TimeoutExpired:
        fail("Unable to check whether the account already exists")
    if result.returncode == 0:
        return True
    if result.returncode == 2:
        return False
    fail("Unable to check whether the account already exists")


def list_accounts(managed):
    rows = []
    for line in run(["getent", "passwd"]).splitlines():
        parts = line.split(":")
        if len(parts) != 7:
            continue
        name, _, uid, gid, _, home, shell = parts
        try:
            numeric_uid = int(uid)
        except ValueError:
            continue
        if managed.get(name) != numeric_uid or numeric_uid < SYSTEM_UID_MIN:
            continue
        expiry = ""
        try:
            expiry = run(["chage", "-l", name]).split("Account expires:", 1)[1].strip()
            if expiry.lower() in {"never", "never expires"}:
                expiry = ""
        except (SystemExit, IndexError):
            expiry = ""
        rows.append({"username": name, "uid": numeric_uid, "home": home,
                     "shell": shell, "expiry": expiry})
    return rows


def main():
    if os.geteuid() != 0:
        fail("This helper must run as root")
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        fail("Request is too large")
    try:
        request = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("Invalid JSON request")
    if not isinstance(request, dict) or not isinstance(request.get("action"), str):
        fail("Invalid request")
    action = request["action"]

    with registry_lock():
        managed = load_registry()
        if action == "list":
            if set(request) != {"action"}:
                fail("Unexpected request fields")
            print(json.dumps(list_accounts(managed)))
            return

        if action == "create":
            if set(request) != {"action", "username", "expiry", "password"}:
                fail("Unexpected request fields")
            name = valid_name(request["username"])
            expiry = valid_expiry(request["expiry"])
            password = request["password"]
            if (not isinstance(password, str) or len(password) < 20 or len(password) > 256
                    or any(ch in password for ch in "\r\n:")):
                fail("Invalid generated password")
            if name in managed or account_exists(name):
                fail("An account with that username already exists")
            run(["useradd", "--create-home", "--shell", "/bin/bash",
                 "--expiredate", expiry, name])
            try:
                created_uid = int(run(["id", "-u", name]))
                if created_uid < SYSTEM_UID_MIN:
                    fail("Created account has an unexpected system UID")
                run(["chpasswd"], f"{name}:{password}\n")
                save_registry({**managed, name: created_uid})
            except SystemExit:
                try:
                    run(["userdel", "--remove", name])
                except SystemExit:
                    pass
                raise
            print("created")
            return

        if action == "expire":
            if set(request) != {"action", "username", "expiry"}:
                fail("Unexpected request fields")
            name = valid_name(request["username"], must_exist=True)
            current_uid = int(run(["id", "-u", name]))
            if managed.get(name) != current_uid:
                fail("This account is not managed by Iyke VPS Manager")
            expiry = valid_expiry(request["expiry"])
            run(["chage", "--expiredate", expiry, name])
            print("updated")
            return

        if action == "delete":
            if set(request) != {"action", "username"}:
                fail("Unexpected request fields")
            name = valid_name(request["username"], must_exist=True)
            current_uid = int(run(["id", "-u", name]))
            if managed.get(name) != current_uid:
                fail("This account is not managed by Iyke VPS Manager")
            run(["userdel", "--remove", name])
            updated_registry = dict(managed)
            updated_registry.pop(name)
            save_registry(updated_registry)
            print("deleted")
            return

    fail("Unsupported action")


if __name__ == "__main__":
    main()
