    os_id = next(
        (line.split("=", 1)[1].strip().strip('"').strip("'")
         for line in os_release.splitlines() if line.startswith("ID=")),
        "",
    )
    if os_id not in {"ubuntu", "debian"}:
        fail("Xray installation supports Ubuntu and Debian only")

    systemd_run = shutil.which("systemd-run")
    if not systemd_run:
        fail("systemd-run is unavailable; cannot safely install Xray from the panel")

    protected_paths = (
        "/usr/local/bin/xray",
        "/etc/systemd/system/xray.service",
        "/etc/systemd/system/xray@.service",
        "/usr/local/etc/xray",
        "/usr/local/share/xray",
        "/var/log/xray",
    )
    if any(os.path.lexists(path) for path in protected_paths):
        fail("An Xray installation or configuration already exists; refusing to overwrite it")

    account = subprocess.run(
        ["getent", "passwd", "xray"], text=True, capture_output=True,
        check=False, timeout=10,
    )
    if account.returncode == 0:
        fail("The xray system account already exists; refusing to reuse it")
    if account.returncode != 2:
        fail("Unable to check whether the xray system account already exists")

    # The installer revision is immutable; its release download routine verifies
    # the Xray archive against the upstream published SHA256 digest.
    shell_script = (
        "set -euo pipefail; "
        "tmp=$(mktemp); trap 'rm -f \"$tmp\"' EXIT; "
        "curl -fsSL --retry 3 --connect-timeout 15 --max-time 60 "
        f"'{XRAY_INSTALLER_URL}' -o \"$tmp\"; "
        "bash \"$tmp\" install --without-logfiles"
    )
    unit = f"iyke-vps-manager-xray-install-{os.getpid()}-{os.urandom(4).hex()}"
    command = [
        systemd_run, "--quiet", "--wait", "--pipe", "--collect",
        f"--unit={unit}", "--property=RuntimeMaxSec=300",
        "--setenv=DEBIAN_FRONTEND=noninteractive",
        "/bin/bash", "-c", shell_script,
    ]
    try:
        result = subprocess.run(
            command, text=True, capture_output=True, check=True, timeout=330
        )
    except subprocess.TimeoutExpired:
        fail("Xray installation timed out")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "Xray installation failed").strip()
        fail(f"Xray installation failed: {detail[-500:]}")

    if not os.path.isfile("/usr/local/bin/xray") or not os.access("/usr/local/bin/xray", os.X_OK):
        fail("Xray installer completed without installing the expected binary")
    if not os.path.isfile("/etc/systemd/system/xray.service"):
        fail("Xray installer completed without creating its system service")
    return {
        "installed": True,
        "service": _unit_state("xray.service"),
        "installer": "official-pinned",
        "firewall_changed": False,
    }


