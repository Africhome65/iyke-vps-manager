        if set(request) != {"action", "name", "protocol"}:
            fail("Unexpected request fields")
        print(json.dumps(xray_create_client(request["name"], request["protocol"])))
        return True
    if action == "xray_revoke_client":
        if set(request) != {"action", "name"}:
            fail("Unexpected request fields")
        print(json.dumps(xray_revoke_client(request["name"])))
        return True
    return False


