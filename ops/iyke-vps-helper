#!/usr/bin/env python3
"""Strict JSON privileged helper. Installed root-owned; invoked through one fixed sudo command."""
import datetime
import fcntl
import json
import ipaddress
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.request
import uuid
from contextlib import contextmanager

NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,30}\$?$")
SYSTEM_UID_MIN = 1000
MAX_REQUEST_BYTES = 8192
STATE_DIR = "/var/lib/iyke-vps-manager-state"


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def run(argv, input_text=None):
    try:
        result = subprocess.run(argv, input=input_text, text=True, capture_output=True,
                                check=False, timeout=30)
    except subprocess.TimeoutExpired:
        fail("System command timed out")
    if result.returncode:
        fail(result.stderr.strip() or "System command failed")
    return result.stdout.strip()


def state_path(name):
    return os.path.join(STATE_DIR, name)


def check_state_dir():
    try:
        info = os.lstat(STATE_DIR)
    except OSError:
        fail("Managed-account state directory is unavailable")
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) & 0o077):
        fail("Managed-account state directory has unsafe ownership or permissions")


@contextmanager
def registry_lock():
    check_state_dir()
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(state_path("managed-users.lock"), flags, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            os.close(fd)
            fail("Managed-account lock file is unsafe")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "r+") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            yield
    except OSError:
        fail("Unable to lock managed-account registry")


def load_registry():
    check_state_dir()
    path = state_path("managed-users.json")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return {}
    except OSError:
        fail("Unable to open managed-account registry")
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            fail("Managed-account registry file is unsafe")
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            data = json.load(source)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("Managed-account registry is unreadable or corrupted")
    finally:
        if fd >= 0:
            os.close(fd)
    if (not isinstance(data, dict) or any(
            not isinstance(name, str) or not NAME.fullmatch(name)
            or name in {"root", "nobody"} or isinstance(uid, bool)
            or not isinstance(uid, int) or uid < SYSTEM_UID_MIN
            for name, uid in data.items()
    )):
        fail("Managed-account registry contains invalid data")
    return data


def save_registry(names):
    check_state_dir()
    if (not isinstance(names, dict) or any(
            not isinstance(name, str) or not NAME.fullmatch(name)
            or isinstance(uid, bool) or not isinstance(uid, int) or uid < SYSTEM_UID_MIN
            for name, uid in names.items()
    )):
        fail("Refusing to save invalid managed-account data")
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".managed-users-", dir=STATE_DIR)
        os.fchmod(fd, 0o600)
        os.fchown(fd, os.geteuid(), os.getegid())
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            json.dump({name: names[name] for name in sorted(names)}, target, separators=(",", ":"))
            target.write("\n")
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, state_path("managed-users.json"))
        temporary = None
        directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        fail("Unable to update managed-account registry")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def valid_name(value, must_exist=False):
    if not isinstance(value, str) or not NAME.fullmatch(value) or value in {"root", "nobody"}:
        fail("Invalid or protected username")
    if must_exist:
        try:
            uid = int(run(["id", "-u", value]))
        except (ValueError, SystemExit):
            fail("User account does not exist")
        if uid < SYSTEM_UID_MIN:
            fail("Refusing to modify a system account")
    return value


def valid_expiry(value):
    if not isinstance(value, str):
        fail("Expiry must use YYYY-MM-DD")
    try:
        parsed = datetime.date.fromisoformat(value)
        if parsed <= datetime.date.today():
            fail("Expiry must be in the future")
    except ValueError:
        fail("Expiry must use YYYY-MM-DD")
    return value


def account_exists(name):
    try:
        result = subprocess.run(["getent", "passwd", name], text=True, capture_output=True,
                                check=False, timeout=10)
    except subprocess.TimeoutExpired:
        fail("Unable to check whether the account already exists")
    if result.returncode == 0:
        return True
    if result.returncode == 2:
        return False
    fail("Unable to check whether the account already exists")


def list_accounts(managed):
    rows = []
    for line in run(["getent", "passwd"]).splitlines():
        parts = line.split(":")
        if len(parts) != 7:
            continue
        name, _, uid, gid, _, home, shell = parts
        try:
            numeric_uid = int(uid)
        except ValueError:
            continue
        if managed.get(name) != numeric_uid or numeric_uid < SYSTEM_UID_MIN:
            continue
        expiry = ""
        try:
            chage_output = run(["chage", "-l", name])
            match = re.search(r"^\s*Account expires\s*:\s*(.*?)\s*$",
                              chage_output, re.MULTILINE)
            if match:
                expiry = match.group(1)
                if expiry.lower() in {"never", "never expires"}:
                    expiry = ""
        except SystemExit:
            expiry = ""
        rows.append({"username": name, "uid": numeric_uid, "home": home,
                     "shell": shell, "expiry": expiry})
    return rows



def _unit_state(unit):
    try:
        result = subprocess.run(["systemctl", "is-active", unit], text=True,
                                capture_output=True, check=False, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    state = result.stdout.strip()
    return state if state in {"active", "inactive", "failed", "activating",
                              "deactivating", "reloading"} else "unknown"


def vpn_status():
    """Return service metadata only; never expose private keys or config contents."""
    wireguard_installed = shutil.which("wg") is not None
    wireguard = {"installed": wireguard_installed, "interfaces": []}
    if wireguard_installed:
        try:
            result = subprocess.run(["wg", "show", "interfaces"], text=True,
                                    capture_output=True, check=False, timeout=5)
            if result.returncode == 0:
                for interface in result.stdout.split():
                    if re.fullmatch(r"[A-Za-z0-9_=+.-]{1,15}", interface):
                        wireguard["interfaces"].append({
                            "name": interface,
                            "status": "active"
                        })
        except (OSError, subprocess.TimeoutExpired):
            pass

    openvpn_installed = shutil.which("openvpn") is not None
    openvpn = {"installed": openvpn_installed, "instances": []}
    if openvpn_installed:
        for directory, unit_prefix in (
            ("/etc/openvpn/server", "openvpn-server@"),
            ("/etc/openvpn", "openvpn@"),
        ):
            try:
                entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
            except OSError:
                continue
            for entry in entries:
                if (not entry.name.endswith(".conf")
                        or not entry.is_file(follow_symlinks=False)):
                    continue
                instance = entry.name[:-5]
                if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", instance):
                    continue
                openvpn["instances"].append({
                    "name": instance,
                    "status": _unit_state(f"{unit_prefix}{instance}.service")
                })
    xray_binary = shutil.which("xray")
    xray = {
        "installed": xray_binary is not None,
        "service": _unit_state("xray.service") if xray_binary else "not-installed",
    }
    return {"wireguard": wireguard, "openvpn": openvpn, "xray": xray}




def _secure_wireguard_dir():
    directory = "/etc/wireguard"
    try:
        os.mkdir(directory, 0o700)
    except FileExistsError:
        pass
    try:
        info = os.lstat(directory)
    except OSError:
        fail("WireGuard configuration directory is unavailable")
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
        fail("WireGuard configuration directory has unsafe ownership or type")
    os.chmod(directory, 0o700)
    return directory


def _atomic_secret_file(path, content, mode=0o600):
    directory = os.path.dirname(path)
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".iyke-wg-", dir=directory)
        os.fchmod(fd, mode)
        os.fchown(fd, 0, 0)
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, path)
        temporary = None
        dir_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except OSError:
        fail("Unable to write WireGuard configuration securely")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def _run_apt_task(apt_get, arguments, task):
    """Run a fixed APT task in a transient system service outside the web sandbox."""
    systemd_run = shutil.which("systemd-run")
    if not systemd_run:
        fail("systemd-run is unavailable; cannot safely install WireGuard from the panel")
    unit = f"iyke-vps-manager-apt-{task}-{os.getpid()}-{os.urandom(4).hex()}"
    command = [
        systemd_run, "--quiet", "--wait", "--pipe", "--collect",
        f"--unit={unit}", "--property=RuntimeMaxSec=240",
        "--setenv=DEBIAN_FRONTEND=noninteractive",
        apt_get, *arguments,
    ]
    try:
        subprocess.run(command, text=True, capture_output=True, check=True, timeout=270)
    except subprocess.TimeoutExpired:
        fail(f"WireGuard package {task} timed out")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "APT task failed").strip()
        fail(f"WireGuard package {task} failed: {detail[-500:]}")


def wireguard_install():
    """Install WireGuard and create a private server config; do not alter firewall or start it."""
    if not os.path.exists("/etc/os-release"):
        fail("WireGuard installation supports Ubuntu and Debian only")
    try:
        with open("/etc/os-release", encoding="utf-8") as source:
            os_release = source.read()
    except OSError:
        fail("Unable to identify this operating system")
    if not re.search(r'^ID=(ubuntu|debian)$', os_release, re.MULTILINE):
        fail("WireGuard installation supports Ubuntu and Debian only")
    directory = "/etc/wireguard"
    if os.path.lexists(os.path.join(directory, "wg0.conf")):
        fail("A wg0.conf already exists; refusing to overwrite it")
    _secure_wireguard_dir()
    apt_get = shutil.which("apt-get")
    if not apt_get:
        fail("APT package manager is unavailable")
    _run_apt_task(apt_get, ["update"], "update")
    _run_apt_task(apt_get, ["install", "-y", "wireguard"], "install")
    if not shutil.which("wg"):
        fail("WireGuard installation did not provide the wg command")
    private_key = run(["wg", "genkey"])
    if not re.fullmatch(r"[A-Za-z0-9+/]{43}=", private_key):
        fail("WireGuard generated an invalid server key")
    public_key = run(["wg", "pubkey"], private_key + "\n")
    if not re.fullmatch(r"[A-Za-z0-9+/]{43}=", public_key):
        fail("WireGuard generated an invalid public key")
    config = ("# Managed by Iyke VPS Manager; do not edit manually.\n"
              "[Interface]\n"
              "Address = 10.66.0.1/24\n"
              "ListenPort = 51820\n"
              f"PrivateKey = {private_key}\n")
    _atomic_secret_file(os.path.join(directory, "wg0.conf"), config, 0o600)
    _atomic_secret_file(os.path.join(directory, "server.pub"), public_key + "\n", 0o644)
    return {"installed": True, "interface": "wg0", "public_key": public_key,
            "service": "inactive", "firewall_changed": False}


def wireguard_public_endpoint():
    """Discover this VPS public IPv4 address for client endpoint configuration."""
    try:
        request = urllib.request.Request(
            "https://api.ipify.org",
            headers={"User-Agent": "Iyke-VPS-Manager/1.0"},
        )
        with urllib.request.urlopen(request, timeout=5) as response:
            raw = response.read(64).decode("ascii").strip()
        address = ipaddress.ip_address(raw)
    except (OSError, UnicodeDecodeError, ValueError):
        fail("Unable to detect this VPS public IP; enter its public IP or DNS name manually")
    if not isinstance(address, ipaddress.IPv4Address) or not address.is_global:
        fail("The detected address is not a public IPv4 address; enter the VPS public IP or DNS name manually")
    return {"host": str(address), "port": 51820, "endpoint": f"{address}:51820"}


def wireguard_service(state):
    if state not in {"start", "stop"}:
        fail("Invalid WireGuard service state")
    config = "/etc/wireguard/wg0.conf"
    try:
        info = os.lstat(config)
    except OSError:
        fail("Install and configure WireGuard before controlling the service")
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o077:
        fail("WireGuard server configuration has unsafe ownership or permissions")
    if state == "start":
        run(["systemctl", "start", "wg-quick@wg0.service"])
    else:
        run(["systemctl", "stop", "wg-quick@wg0.service"])
    return {"interface": "wg0", "requested_state": state}



WG_NAME = re.compile(r"^[a-z][a-z0-9_-]{0,30}$")
WG_KEY = re.compile(r"^[A-Za-z0-9+/]{43}=$")
WG_SUBNET = "10.66.0.0/24"


def _read_root_file(path, mode_mask=0o077):
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        fail("Required WireGuard file is unavailable")
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & mode_mask):
            fail("WireGuard file has unsafe ownership or permissions")
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            return source.read()
    except (OSError, UnicodeDecodeError):
        fail("Unable to read WireGuard file securely")
    finally:
        if fd >= 0:
            os.close(fd)


@contextmanager
def _wireguard_peer_lock():
    directory = _secure_wireguard_dir()
    path = os.path.join(directory, "peers.lock")
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    fd = None
    try:
        fd = os.open(path, flags, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            fail("WireGuard peer lock file is unsafe")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "r+") as lock_file:
            fd = None
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            yield
    except OSError:
        fail("Unable to lock WireGuard peer registry")
    finally:
        if fd is not None:
            os.close(fd)


def _peer_registry():
    directory = _secure_wireguard_dir()
    path = os.path.join(directory, "peers.json")
    if not os.path.lexists(path):
        return {}
    raw = _read_root_file(path)
    try:
        peers = json.loads(raw)
    except json.JSONDecodeError:
        fail("WireGuard peer registry is corrupted")
    if not isinstance(peers, dict):
        fail("WireGuard peer registry is invalid")
    for name, peer in peers.items():
        if (not isinstance(name, str) or not WG_NAME.fullmatch(name)
                or name in {"root", "server"} or not isinstance(peer, dict)
                or set(peer) != {"public_key", "address", "endpoint"}):
            fail("WireGuard peer registry contains invalid data")
        if not isinstance(peer["public_key"], str) or not WG_KEY.fullmatch(peer["public_key"]):
            fail("WireGuard peer registry contains an invalid key")
        try:
            address = ipaddress.ip_interface(peer["address"])
        except (ValueError, TypeError):
            fail("WireGuard peer registry contains an invalid address")
        if address.network.prefixlen != 32 or address.ip not in ipaddress.ip_network(WG_SUBNET):
            fail("WireGuard peer registry contains an out-of-range address")
        if not isinstance(peer["endpoint"], str) or not _valid_endpoint(peer["endpoint"]):
            fail("WireGuard peer registry contains an invalid endpoint")
    return peers


def _save_peer_registry(peers):
    path = os.path.join(_secure_wireguard_dir(), "peers.json")
    _atomic_secret_file(path, json.dumps(peers, sort_keys=True, separators=(",", ":")) + "\n", 0o600)


def _valid_endpoint(value):
    if not isinstance(value, str) or len(value) > 255 or value.count(":") < 1:
        return False
    host, separator, port_text = value.rpartition(":")
    if not separator or not port_text.isdigit() or not 1 <= int(port_text) <= 65535:
        return False
    if not host or any(ch.isspace() for ch in host) or "/" in host or "\\" in host:
        return False
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return bool(re.fullmatch(
            r"(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*",
            host
        ))


def _check_wg_config():
    _secure_wireguard_dir()
    path = "/etc/wireguard/wg0.conf"
    config = _read_root_file(path)
    if (not config.startswith("# Managed by Iyke VPS Manager; do not edit manually.\n")
            or len(re.findall(r"(?m)^\[Interface\]$", config)) != 1
            or len(re.findall(r"(?m)^ListenPort\s*=\s*(\d+)\s*$", config)) != 1
            or len(re.findall(r"(?m)^PrivateKey\s*=", config)) != 1):
        fail("WireGuard configuration is not managed by Iyke VPS Manager; refusing to modify it")
    if not shutil.which("wg"):
        fail("WireGuard is not installed")
    return config


def _wg_active():
    result = subprocess.run(["wg", "show", "wg0"], text=True, capture_output=True,
                            check=False, timeout=10)
    return result.returncode == 0


def _peer_config_text(config, peers):
    base = re.split(r"(?m)^# Iyke peer: [a-z][a-z0-9_-]{0,30}\n", config, maxsplit=1)[0].rstrip()
    blocks = []
    for name in sorted(peers):
        peer = peers[name]
        blocks.append(f"# Iyke peer: {name}\n[Peer]\nPublicKey = {peer['public_key']}\nAllowedIPs = {peer['address']}\n")
    return base + ("\n\n" + "\n".join(blocks) if blocks else "") + "\n"


def _allocate_peer_address(peers):
    used = {str(ipaddress.ip_interface(peer["address"]).ip) for peer in peers.values()}
    for host in range(2, 255):
        candidate = f"10.66.0.{host}"
        if candidate not in used:
            return candidate + "/32"
    fail("The WireGuard client address pool is full")


def _valid_peer_name(name):
    if not isinstance(name, str) or not WG_NAME.fullmatch(name) or name in {"root", "server"}:
        fail("Client name must use lowercase letters, numbers, hyphens or underscores")
    return name


def wireguard_list_peers():
    _check_wg_config()
    peers = _peer_registry()
    return [{"name": name, "address": peers[name]["address"], "endpoint": peers[name]["endpoint"]}
            for name in sorted(peers)]


def _wireguard_create_peer_unlocked(name, endpoint):
    name = _valid_peer_name(name)
    if not _valid_endpoint(endpoint):
        fail("Endpoint must be a public IP address or hostname followed by :port")
    config = _check_wg_config()
    listen_ports = re.findall(r"(?m)^ListenPort\s*=\s*(\d+)\s*$", config)
    endpoint_port = int(endpoint.rpartition(":")[2])
    if not listen_ports or endpoint_port != int(listen_ports[0]):
        fail("Client endpoint port must match the server WireGuard ListenPort")
    peers = _peer_registry()
    if name in peers:
        fail("A WireGuard client with that name already exists")
    address = _allocate_peer_address(peers)
    private_key = run(["wg", "genkey"])
    if not WG_KEY.fullmatch(private_key):
        fail("WireGuard generated an invalid client key")
    public_key = run(["wg", "pubkey"], private_key + "\n")
    if not WG_KEY.fullmatch(public_key):
        fail("WireGuard generated an invalid client public key")
    server_public = _read_root_file("/etc/wireguard/server.pub", mode_mask=0).strip()
    if not WG_KEY.fullmatch(server_public):
        fail("WireGuard server public key is invalid")
    client_config = (
        "[Interface]\n"
        f"PrivateKey = {private_key}\n"
        f"Address = {address}\n"
        "DNS = 1.1.1.1\n\n"
        "[Peer]\n"
        f"PublicKey = {server_public}\n"
        f"Endpoint = {endpoint}\n"
        f"AllowedIPs = {WG_SUBNET}\n"
        "PersistentKeepalive = 25\n"
    )
    updated = dict(peers)
    updated[name] = {"public_key": public_key, "address": address, "endpoint": endpoint}
    directory = _secure_wireguard_dir()
    clients_dir = os.path.join(directory, "clients")
    try:
        os.mkdir(clients_dir, 0o700)
    except FileExistsError:
        pass
    client_info = os.lstat(clients_dir)
    if not stat.S_ISDIR(client_info.st_mode) or client_info.st_uid != 0:
        fail("WireGuard client profile directory is unsafe")
    os.chmod(clients_dir, 0o700)
    profile_path = os.path.join(clients_dir, name + ".conf")
    if os.path.lexists(profile_path):
        fail("A client profile file already exists; refusing to overwrite it")
    active = _wg_active()
    _atomic_secret_file(profile_path, client_config, 0o600)
    try:
        _atomic_secret_file(os.path.join(directory, "wg0.conf"),
                            _peer_config_text(config, updated), 0o600)
        _save_peer_registry(updated)
        if active:
            run(["wg", "set", "wg0", "peer", public_key, "allowed-ips", address])
    except SystemExit:
        _atomic_secret_file(os.path.join(directory, "wg0.conf"), config, 0o600)
        try:
            os.unlink(profile_path)
        except OSError:
            pass
        _save_peer_registry(peers)
        if active:
            try:
                run(["wg", "set", "wg0", "peer", public_key, "remove"])
            except SystemExit:
                pass
        raise
    return {"name": name, "address": address}


def wireguard_get_profile(name):
    name = _valid_peer_name(name)
    peers = _peer_registry()
    if name not in peers:
        fail("WireGuard client does not exist")
    clients_dir = "/etc/wireguard/clients"
    try:
        directory_info = os.lstat(clients_dir)
    except OSError:
        fail("WireGuard client profile directory is unavailable")
    if (not stat.S_ISDIR(directory_info.st_mode) or directory_info.st_uid != 0
            or stat.S_IMODE(directory_info.st_mode) & 0o077):
        fail("WireGuard client profile directory is unsafe")
    path = os.path.join(clients_dir, name + ".conf")
    return _read_root_file(path)


def _wireguard_revoke_peer_unlocked(name):
    name = _valid_peer_name(name)
    config = _check_wg_config()
    peers = _peer_registry()
    if name not in peers:
        fail("WireGuard client does not exist")
    peer = peers[name]
    updated = dict(peers)
    del updated[name]
    active = _wg_active()
    if active:
        run(["wg", "set", "wg0", "peer", peer["public_key"], "remove"])
    try:
        _atomic_secret_file("/etc/wireguard/wg0.conf", _peer_config_text(config, updated), 0o600)
        _save_peer_registry(updated)
        os.unlink(os.path.join("/etc/wireguard/clients", name + ".conf"))
    except (SystemExit, OSError):
        _atomic_secret_file("/etc/wireguard/wg0.conf", config, 0o600)
        _save_peer_registry(peers)
        if active:
            try:
                run(["wg", "set", "wg0", "peer", peer["public_key"],
                     "allowed-ips", peer["address"]])
            except SystemExit:
                pass
        fail("Unable to revoke client cleanly; the previous configuration was restored")
    return {"name": name, "revoked": True}



def wireguard_create_peer(name, endpoint):
    with _wireguard_peer_lock():
        return _wireguard_create_peer_unlocked(name, endpoint)


def wireguard_revoke_peer(name):
    with _wireguard_peer_lock():
        return _wireguard_revoke_peer_unlocked(name)



XRAY_INSTALLER_COMMIT = "1bce9c3a9630d72521643159080017d1c001bc71"
XRAY_INSTALLER_URL = (
    "https://raw.githubusercontent.com/XTLS/Xray-install/"
    + XRAY_INSTALLER_COMMIT + "/install-release.sh"
)


def xray_install():
    """Install official Xray-core on a clean Ubuntu/Debian host; preserve existing installs."""
    try:
        with open("/etc/os-release", encoding="utf-8") as source:
            os_release = source.read()
    except OSError:
        fail("Unable to identify this operating system")
    os_id = next(
        (line.split("=", 1)[1].strip().strip('"').strip("'")
         for line in os_release.splitlines() if line.startswith("ID=")),
        "",
    )
    if os_id not in {"ubuntu", "debian"}:
        fail("Xray installation supports Ubuntu and Debian only")

    systemd_run = shutil.which("systemd-run")
    if not systemd_run:
        fail("systemd-run is unavailable; cannot safely install Xray from the panel")

    protected_paths = (
        "/usr/local/bin/xray",
        "/etc/systemd/system/xray.service",
        "/etc/systemd/system/xray@.service",
        "/usr/local/etc/xray",
        "/usr/local/share/xray",
        "/var/log/xray",
    )
    if any(os.path.lexists(path) for path in protected_paths):
        fail("An Xray installation or configuration already exists; refusing to overwrite it")

    account = subprocess.run(
        ["getent", "passwd", "xray"], text=True, capture_output=True,
        check=False, timeout=10,
    )
    if account.returncode == 0:
        fail("The xray system account already exists; refusing to reuse it")
    if account.returncode != 2:
        fail("Unable to check whether the xray system account already exists")

    # The installer revision is immutable; its release download routine verifies
    # the Xray archive against the upstream published SHA256 digest.
    shell_script = (
        "set -euo pipefail; "
        "tmp=$(mktemp); trap 'rm -f \"$tmp\"' EXIT; "
        "curl -fsSL --retry 3 --connect-timeout 15 --max-time 60 "
        f"'{XRAY_INSTALLER_URL}' -o \"$tmp\"; "
        "bash \"$tmp\" install --without-logfiles"
    )
    unit = f"iyke-vps-manager-xray-install-{os.getpid()}-{os.urandom(4).hex()}"
    command = [
        systemd_run, "--quiet", "--wait", "--pipe", "--collect",
        f"--unit={unit}", "--property=RuntimeMaxSec=300",
        "--setenv=DEBIAN_FRONTEND=noninteractive",
        "/bin/bash", "-c", shell_script,
    ]
    try:
        result = subprocess.run(
            command, text=True, capture_output=True, check=True, timeout=330
        )
    except subprocess.TimeoutExpired:
        fail("Xray installation timed out")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "Xray installation failed").strip()
        fail(f"Xray installation failed: {detail[-500:]}")

    if not os.path.isfile("/usr/local/bin/xray") or not os.access("/usr/local/bin/xray", os.X_OK):
        fail("Xray installer completed without installing the expected binary")
    if not os.path.isfile("/etc/systemd/system/xray.service"):
        fail("Xray installer completed without creating its system service")
    return {
        "installed": True,
        "service": _unit_state("xray.service"),
        "installer": "official-pinned",
        "firewall_changed": False,
    }


XRAY_CLIENTS_FILE = "xray-clients.json"


@contextmanager
def _xray_client_lock():
    check_state_dir()
    path = state_path("xray-clients.lock")
    fd = None
    try:
        fd = os.open(path, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            fail("Xray client lock file is unsafe")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "r+") as lock_file:
            fd = None
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            yield
    except OSError:
        fail("Unable to lock Xray client registry")
    finally:
        if fd is not None:
            os.close(fd)


@contextmanager
def xray_client_lock():
    with _xray_client_lock():
        yield


def _load_xray_clients():
    check_state_dir()
    path = state_path(XRAY_CLIENTS_FILE)
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return []
    except OSError:
        fail("Unable to open Xray client registry")
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077
                or info.st_size > 256 * 1024):
            fail("Xray client registry file is unsafe")
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            data = json.load(source)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("Xray client registry is unreadable or corrupted")
    finally:
        if fd >= 0:
            os.close(fd)
    if not isinstance(data, list) or len(data) > 1000:
        fail("Xray client registry contains invalid data")
    seen = set()
    for row in data:
        if (not isinstance(row, dict) or set(row) != {"name", "protocol", "id"}
                or not isinstance(row["name"], str)
                or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", row["name"])
                or row["protocol"] not in {"vmess", "vless"}
                or not isinstance(row["id"], str)):
            fail("Xray client registry contains invalid data")
        try:
            if str(uuid.UUID(row["id"])) != row["id"]:
                raise ValueError
        except (ValueError, AttributeError):
            fail("Xray client registry contains an invalid client ID")
        if row["name"] in seen:
            fail("Xray client registry contains duplicate names")
        seen.add(row["name"])
    return data


def _save_xray_clients(rows):
    check_state_dir()
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".xray-clients-", dir=STATE_DIR)
        os.fchmod(fd, 0o600)
        os.fchown(fd, os.geteuid(), os.getegid())
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            json.dump(rows, target, separators=(",", ":"))
            target.write("\n")
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, state_path(XRAY_CLIENTS_FILE))
        temporary = None
        directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        fail("Unable to update Xray client registry")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def xray_list_clients():
    with xray_client_lock():
        return [{"name": row["name"], "protocol": row["protocol"]}
                for row in _load_xray_clients()]


def xray_create_client(name, protocol):
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        fail("Invalid Xray client name")
    if name in {"root", "server", "ca"}:
        fail("That Xray client name is reserved")
    if protocol not in {"vmess", "vless"}:
        fail("Unsupported Xray client protocol")
    if not os.path.isfile("/usr/local/bin/xray") or not os.access("/usr/local/bin/xray", os.X_OK):
        fail("Install Xray-core before creating clients")
    with xray_client_lock():
        rows = _load_xray_clients()
        if any(row["name"] == name for row in rows):
            fail("An Xray client with that name already exists")
        if len(rows) >= 1000:
            fail("The Xray client limit has been reached")
        client_id = str(uuid.uuid4())
        rows.append({"name": name, "protocol": protocol, "id": client_id})
        _save_xray_clients(rows)
    return {"created": True, "name": name, "protocol": protocol, "id": client_id}


def xray_revoke_client(name):
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        fail("Invalid Xray client name")
    with xray_client_lock():
        rows = _load_xray_clients()
        updated = [row for row in rows if row["name"] != name]
        if len(updated) == len(rows):
            fail("Xray client was not found")
        _save_xray_clients(updated)
    return {"revoked": True, "name": name}


