#!/usr/bin/env python3
"""Strict JSON privileged helper. Installed root-owned; invoked through one fixed sudo command."""
import datetime
import fcntl
import json
import ipaddress
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.request
import uuid
from contextlib import contextmanager

NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,30}\$?$")
SYSTEM_UID_MIN = 1000
MAX_REQUEST_BYTES = 8192
STATE_DIR = "/var/lib/iyke-vps-manager-state"


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def run(argv, input_text=None):
    try:
        result = subprocess.run(argv, input=input_text, text=True, capture_output=True,
                                check=False, timeout=30)
    except subprocess.TimeoutExpired:
        fail("System command timed out")
    if result.returncode:
        fail(result.stderr.strip() or "System command failed")
    return result.stdout.strip()


def state_path(name):
    return os.path.join(STATE_DIR, name)


def check_state_dir():
    try:
        info = os.lstat(STATE_DIR)
    except OSError:
        fail("Managed-account state directory is unavailable")
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) & 0o077):
        fail("Managed-account state directory has unsafe ownership or permissions")


@contextmanager
def registry_lock():
    check_state_dir()
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(state_path("managed-users.lock"), flags, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            os.close(fd)
            fail("Managed-account lock file is unsafe")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "r+") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            yield
    except OSError:
        fail("Unable to lock managed-account registry")


def load_registry():
    check_state_dir()
    path = state_path("managed-users.json")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return {}
    except OSError:
        fail("Unable to open managed-account registry")
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            fail("Managed-account registry file is unsafe")
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            data = json.load(source)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("Managed-account registry is unreadable or corrupted")
    finally:
        if fd >= 0:
            os.close(fd)
    if (not isinstance(data, dict) or any(
            not isinstance(name, str) or not NAME.fullmatch(name)
            or name in {"root", "nobody"} or isinstance(uid, bool)
            or not isinstance(uid, int) or uid < SYSTEM_UID_MIN
            for name, uid in data.items()
    )):
        fail("Managed-account registry contains invalid data")
    return data


def save_registry(names):
    check_state_dir()
    if (not isinstance(names, dict) or any(
            not isinstance(name, str) or not NAME.fullmatch(name)
            or isinstance(uid, bool) or not isinstance(uid, int) or uid < SYSTEM_UID_MIN
            for name, uid in names.items()
    )):
        fail("Refusing to save invalid managed-account data")
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".managed-users-", dir=STATE_DIR)
        os.fchmod(fd, 0o600)
        os.fchown(fd, os.geteuid(), os.getegid())
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            json.dump({name: names[name] for name in sorted(names)}, target, separators=(",", ":"))
            target.write("\n")
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, state_path("managed-users.json"))
        temporary = None
        directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        fail("Unable to update managed-account registry")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def valid_name(value, must_exist=False):
    if not isinstance(value, str) or not NAME.fullmatch(value) or value in {"root", "nobody"}:
        fail("Invalid or protected username")
    if must_exist:
        try:
            uid = int(run(["id", "-u", value]))
        except (ValueError, SystemExit):
            fail("User account does not exist")
        if uid < SYSTEM_UID_MIN:
            fail("Refusing to modify a system account")
    return value


def valid_expiry(value):
    if not isinstance(value, str):
        fail("Expiry must use YYYY-MM-DD")
    try:
        parsed = datetime.date.fromisoformat(value)
        if parsed <= datetime.date.today():
            fail("Expiry must be in the future")
    except ValueError:
        fail("Expiry must use YYYY-MM-DD")
    return value


def account_exists(name):
    try:
        result = subprocess.run(["getent", "passwd", name], text=True, capture_output=True,
                                check=False, timeout=10)
    except subprocess.TimeoutExpired:
        fail("Unable to check whether the account already exists")
    if result.returncode == 0:
        return True
    if result.returncode == 2:
        return False
    fail("Unable to check whether the account already exists")


def list_accounts(managed):
    rows = []
    for line in run(["getent", "passwd"]).splitlines():
        parts = line.split(":")
        if len(parts) != 7:
            continue
        name, _, uid, gid, _, home, shell = parts
        try:
            numeric_uid = int(uid)
        except ValueError:
            continue
        if managed.get(name) != numeric_uid or numeric_uid < SYSTEM_UID_MIN:
            continue
        expiry = ""
        try:
            chage_output = run(["chage", "-l", name])
            match = re.search(r"^\s*Account expires\s*:\s*(.*?)\s*$",
                              chage_output, re.MULTILINE)
            if match:
                expiry = match.group(1)
                if expiry.lower() in {"never", "never expires"}:
                    expiry = ""
        except SystemExit:
            expiry = ""
        rows.append({"username": name, "uid": numeric_uid, "home": home,
                     "shell": shell, "expiry": expiry})
    return rows



def _unit_state(unit):
    try:
        result = subprocess.run(["systemctl", "is-active", unit], text=True,
                                capture_output=True, check=False, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    state = result.stdout.strip()
    return state if state in {"active", "inactive", "failed", "activating",
                              "deactivating", "reloading"} else "unknown"


def _caddy_public_hostname():
    """Read one unambiguous public DNS site label from the existing Caddyfile."""
    path = "/etc/caddy/Caddyfile"
    for directory in ("/etc", "/etc/caddy"):
        try:
            info = os.lstat(directory)
        except OSError:
            return ""
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0
                or stat.S_IMODE(info.st_mode) & 0o022):
            return ""
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o022
                or info.st_size > 256 * 1024):
            return ""
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = None
            content = source.read()
    except (OSError, UnicodeDecodeError):
        return ""
    finally:
        if fd is not None:
            os.close(fd)
    hosts = set()
    for match in re.finditer(r"(?m)^\s*([^\s{}#]+)\s*\{\s*(?:#.*)?$", content):
        address = match.group(1)
        # Ignore global options, localhost, wildcard and port-only site labels.
        if address.startswith(("(", ":", "localhost", "http://", "https://", "*")):
            continue
        for candidate in address.split(","):
            candidate = candidate.strip().rstrip(".")
            if ":" in candidate or "/" in candidate:
                continue
            labels = candidate.split(".")
            if (len(labels) < 2 or any(
                    not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label)
                    for label in labels)):
                continue
            hosts.add(candidate.lower())
    return next(iter(hosts)) if len(hosts) == 1 else ""


def _xray_config_summary():
    """Read only non-secret inbound metadata from the existing Xray config."""
    path = "/usr/local/etc/xray/config.json"
    for directory in ("/usr", "/usr/local", "/usr/local/etc", "/usr/local/etc/xray"):
        try:
            info = os.lstat(directory)
        except OSError:
            return {"config_status": "unavailable", "inbounds": []}
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0
                or stat.S_IMODE(info.st_mode) & 0o022):
            return {"config_status": "unsafe", "inbounds": []}
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o022
                or info.st_size > 1024 * 1024):
            return {"config_status": "unsafe", "inbounds": []}
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = None
            config = json.load(source)
    except FileNotFoundError:
        return {"config_status": "unavailable", "inbounds": []}
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return {"config_status": "invalid", "inbounds": []}
    finally:
        if fd is not None:
            os.close(fd)
    if not isinstance(config, dict) or not isinstance(config.get("inbounds", []), list):
        return {"config_status": "invalid", "inbounds": []}

    inbounds = []
    for inbound in config.get("inbounds", []):
        if not isinstance(inbound, dict):
            return {"config_status": "invalid", "inbounds": []}
        protocol = inbound.get("protocol", "")
        port = inbound.get("port")
        listen = inbound.get("listen", "0.0.0.0")
        if (not isinstance(protocol, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", protocol)
                or isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535
                or not isinstance(listen, str) or len(listen) > 255
                or any(ord(ch) < 32 for ch in listen)):
            return {"config_status": "invalid", "inbounds": []}
        stream = inbound.get("streamSettings", {})
        if not isinstance(stream, dict):
            return {"config_status": "invalid", "inbounds": []}
        network = stream.get("network", "tcp")
        security = stream.get("security", "none")
        if (not isinstance(network, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,15}", network)
                or not isinstance(security, str)
                or not re.fullmatch(r"[a-z][a-z0-9-]{0,15}", security)):
            return {"config_status": "invalid", "inbounds": []}
        row = {"protocol": protocol, "listen": listen, "port": port,
               "network": network, "security": security}
        ws = stream.get("wsSettings", {})
        if isinstance(ws, dict):
            ws_path = ws.get("path")
            if isinstance(ws_path, str) and len(ws_path) <= 128 and ws_path.startswith("/") and not any(
                    ord(ch) < 32 for ch in ws_path):
                row["path"] = ws_path
        inbounds.append(row)
    return {"config_status": "readable", "inbounds": inbounds}




def _openvpn_pki_candidates():
    root_home = os.path.expanduser("~root")
    return [
        "/etc/openvpn/easy-rsa/pki",
        "/etc/easy-rsa/pki",
        "/usr/share/easy-rsa/pki",
        os.path.join(root_home, "openvpn-ca", "pki"),
    ]


def _safe_root_directory(path):
    """Require every directory component to be root-controlled and non-symlinked."""
    try:
        absolute = os.path.abspath(path)
        current = os.path.sep
        for component in absolute.split(os.path.sep)[1:]:
            current = os.path.join(current, component)
            info = os.lstat(current)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
                return False
            writable = stat.S_IMODE(info.st_mode) & 0o022
            sticky_root_directory = bool(info.st_mode & stat.S_ISVTX)
            if writable and not sticky_root_directory:
                return False
        return True
    except OSError:
        return False


def _read_openvpn_index(path):
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            return None
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            contents = source.read(1024 * 1024 + 1)
        return contents if len(contents) <= 1024 * 1024 else None
    except (OSError, UnicodeDecodeError):
        return None
    finally:
        if fd >= 0:
            os.close(fd)


def _openvpn_index_clients(index_text):
    """Parse Easy-RSA index metadata only; never read certificate or key files."""
    clients = []
    for line in index_text.splitlines():
        fields = line.split("\t")
        if len(fields) != 6 or fields[0] not in {"V", "R", "E"}:
            continue
        status, expiry_raw, revoked_raw, serial, _filename, subject = fields
        cn_match = re.search(r"(?:^|/)CN=([^/]+)", subject)
        if not cn_match:
            continue
        common_name = cn_match.group(1).replace(r"\/", "/")
        if (not common_name or len(common_name) > 128
                or any(ord(char) < 32 or ord(char) == 127 for char in common_name)):
            continue
        try:
            expiry = datetime.datetime.strptime(expiry_raw, "%y%m%d%H%M%SZ").replace(
                tzinfo=datetime.timezone.utc)
        except ValueError:
            continue
        current_status = status
        if current_status == "V" and expiry <= datetime.datetime.now(datetime.timezone.utc):
            current_status = "E"
        clients.append({
            "common_name": common_name,
            "status": {"V": "valid", "R": "revoked", "E": "expired"}[current_status],
            "expires": expiry.date().isoformat(),
            "serial": serial[:64],
        })
    clients.sort(key=lambda item: item["common_name"].casefold())
    return clients


def _openvpn_unique_pki(require_ca_key=False):
    """Return the sole protected Easy-RSA PKI, or fail closed."""
    candidates = []
    seen = set()
    for path in _openvpn_pki_candidates():
        normalized = os.path.normpath(path)
        if normalized in seen:
            continue
        seen.add(normalized)
        if not (_safe_root_directory(normalized)
                and _safe_root_directory(os.path.join(normalized, "issued"))
                and _safe_root_directory(os.path.join(normalized, "private"))):
            continue
        index = _read_openvpn_index(os.path.join(normalized, "index.txt"))
        if index is None:
            continue
        candidates.append((normalized, index))
    if len(candidates) != 1:
        fail("No trusted Easy-RSA database found" if not candidates
             else "More than one Easy-RSA database found; configure one explicitly")
    selected = candidates[0]
    if require_ca_key:
        ca_key_fd = _openvpn_trusted_file(
            os.path.join(selected[0], "private", "ca.key"), 1024 * 1024
        )
        if ca_key_fd is None:
            fail("The trusted Easy-RSA CA private key is missing or unsafe")
        ca_key_info = os.fstat(ca_key_fd)
        ca_key_header = os.read(ca_key_fd, 4096)
        os.close(ca_key_fd)
        if stat.S_IMODE(ca_key_info.st_mode) & 0o077:
            fail("The Easy-RSA CA private key must be accessible only to root")
        if (b"BEGIN ENCRYPTED PRIVATE KEY" in ca_key_header
                or b"Proc-Type: 4,ENCRYPTED" in ca_key_header):
            fail("The Easy-RSA CA private key is encrypted; passphrase-based issuance and revocation are not supported")
    return selected


def _openvpn_easyrsa_path():
    candidate = shutil.which("easyrsa")
    if not candidate:
        fail("Easy-RSA is not installed; client issuance is unavailable")
    path = os.path.realpath(candidate)
    if not _safe_root_directory(os.path.dirname(path)):
        fail("Easy-RSA executable path is unsafe")
    fd = _openvpn_trusted_file(path, 4 * 1024 * 1024)
    if fd is None:
        fail("Easy-RSA executable is unsafe")
    try:
        info = os.fstat(fd)
        if not (info.st_mode & stat.S_IXUSR):
            fail("Easy-RSA executable is not executable by root")
    finally:
        os.close(fd)
    return path


def _openvpn_secure_issued_key(path):
    """Immediately restrict a newly issued private key to root read/write only."""
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            return False
        os.fchmod(fd, 0o600)
        secured = os.fstat(fd)
        return (stat.S_IMODE(secured.st_mode) == 0o600
                and secured.st_uid == 0 and secured.st_nlink == 1)
    except OSError:
        return False
    finally:
        if fd is not None:
            os.close(fd)


def _openvpn_remove_issued_artifact(path):
    """Remove one newly created root-owned regular PKI artifact without following links."""
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            return False
        os.unlink(path)
        return not os.path.lexists(path)
    except FileNotFoundError:
        return True
    except OSError:
        return False


def _openvpn_remove_unsafe_issued_key(path):
    """Remove a newly created key if its permissions cannot be made root-only."""
    return _openvpn_remove_issued_artifact(path)


def _openvpn_cleanup_failed_issuance(pki, name, easyrsa):
    """Make a partially issued identity unusable and verify revocation in the CA index."""
    key_path = os.path.join(pki, "private", name + ".key")
    cert_path = os.path.join(pki, "issued", name + ".crt")
    if not _openvpn_secure_issued_key(key_path):
        if not _openvpn_remove_unsafe_issued_key(key_path):
            fail("Failed issuance left a private key that could not be secured or removed; manual recovery is required")
    index_path = os.path.join(pki, "index.txt")
    current_index = _read_openvpn_index(index_path)
    if current_index is None:
        _openvpn_remove_issued_artifact(key_path)
        _openvpn_remove_issued_artifact(cert_path)
        fail("Failed issuance could not be reconciled with the CA index; manual recovery is required")
    record = next((row for row in _openvpn_index_clients(current_index)
                   if row["common_name"] == name), None)
    if record is None:
        if (not _openvpn_remove_issued_artifact(key_path)
                or not _openvpn_remove_issued_artifact(cert_path)):
            fail("Unindexed failed issuance artifacts could not be removed; manual recovery is required")
        return
    try:
        crl_path = os.path.join(pki, "crl.pem")
        if record["status"] == "valid":
            _openvpn_run_easyrsa(easyrsa, pki, ["revoke", name])
            revoked_index = _read_openvpn_index(index_path)
            revoked = next((row for row in _openvpn_index_clients(revoked_index or "")
                            if row["common_name"] == name), None)
            if revoked is None or revoked["status"] != "revoked":
                fail("Failed issuance certificate could not be confirmed revoked")
            # Always regenerate after a new revoke, even if a stale CRL happens
            # to contain this serial; the index is the authoritative transition.
            regenerate_crl = True
        elif record["status"] == "revoked":
            # Easy-RSA can update index.txt and then fail before CRL generation.
            # A matching serial is insufficient unless the CRL verifies against
            # this PKI's trusted CA certificate.
            regenerate_crl = not (
                _openvpn_crl_contains_serial(crl_path, record["serial"])
                and _openvpn_crl_signed_by_ca(crl_path, pki)
            )
        else:
            fail("Failed issuance certificate has an unexpected CA index status")
        if regenerate_crl:
            _openvpn_run_easyrsa(easyrsa, pki, ["gen-crl"])
            if (not _openvpn_crl_contains_serial(crl_path, record["serial"])
                    or not _openvpn_crl_signed_by_ca(crl_path, pki)):
                fail("Failed issuance CRL is missing the revoked serial or has an invalid CA signature")
    except BaseException:
        _openvpn_remove_issued_artifact(key_path)
        fail("Failed issuance revocation or CRL verification failed; private key removed, manual CA recovery is required")
    # A failed issuance must never leave a locally usable client identity.
    if not _openvpn_remove_issued_artifact(key_path):
        fail("Failed issuance private key could not be removed; manual recovery is required")


def _openvpn_create_client_unlocked(name, locked_pki):
    """Issue a passwordless client keypair and certificate without returning its private key."""
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        fail("Invalid OpenVPN client name")
    if name in {"root", "server", "ca"}:
        fail("That OpenVPN client name is reserved")
    pki, index_text = _openvpn_unique_pki(require_ca_key=True)
    if os.path.realpath(pki) != os.path.realpath(locked_pki):
        fail("The trusted Easy-RSA database changed while acquiring its lock")
    if any(row["common_name"] == name for row in _openvpn_index_clients(index_text)):
        fail("An OpenVPN certificate with that client name already exists")
    key_path = os.path.join(pki, "private", name + ".key")
    cert_path = os.path.join(pki, "issued", name + ".crt")
    if os.path.lexists(cert_path) or os.path.lexists(key_path):
        fail("Client certificate or key file already exists; refusing to overwrite")
    easyrsa = _openvpn_easyrsa_path()
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "EASYRSA_PKI": pki,
        "EASYRSA_BATCH": "1",
        "EASYRSA_REQ_CN": name,
    }
    try:
        result = subprocess.run(
            ["/bin/sh", "-c", 'umask 077; exec "$@"', "iyke-openvpn-easyrsa",
             easyrsa, "--batch", "build-client-full", name, "nopass"],
            cwd=os.path.dirname(easyrsa), env=env, text=True,
            capture_output=True, check=False, timeout=90,
        )
        if result.returncode != 0:
            fail("Easy-RSA client issuance failed")
        # Do this before certificate/index validation: never leave an issued key
        # readable by group or other users, even on a rejected issuance.
        if not _openvpn_secure_issued_key(key_path):
            if not _openvpn_remove_unsafe_issued_key(key_path):
                fail("Easy-RSA created a private key that could not be secured or removed")
            fail("Easy-RSA did not create a safely stored client private key")
        if not _openvpn_certificate_is_client(cert_path):
            fail("Issued certificate is not verified for TLS client authentication")
        cert_fd = _openvpn_trusted_file(cert_path, 1024 * 1024)
        key_fd = _openvpn_trusted_file(key_path, 1024 * 1024)
        if cert_fd is None or key_fd is None:
            if cert_fd is not None:
                os.close(cert_fd)
            if key_fd is not None:
                os.close(key_fd)
            fail("Easy-RSA did not produce a safely stored client certificate and key")
        key_info = os.fstat(key_fd)
        os.close(cert_fd)
        os.close(key_fd)
        if stat.S_IMODE(key_info.st_mode) != 0o600 or key_info.st_uid != 0:
            fail("Easy-RSA created a client private key with unsafe permissions")
        updated_index = _read_openvpn_index(os.path.join(pki, "index.txt"))
        if updated_index is None or not any(
            row["common_name"] == name and row["status"] == "valid"
            for row in _openvpn_index_clients(updated_index)
        ):
            fail("Client issuance completed but the certificate index could not be verified")
    except BaseException:
        # A timed-out or rejected Easy-RSA operation can still have partially
        # written a certificate/key. Reconcile the CA index and revoke any
        # valid serial before returning the original error.
        _openvpn_cleanup_failed_issuance(pki, name, easyrsa)
        raise
    return {"created": True, "name": name}


@contextmanager
def _openvpn_pki_lock(pki):
    if not _safe_root_directory(pki):
        fail("Easy-RSA PKI directory is unsafe")
    path = os.path.join(pki, ".iyke-vps-manager.lock")
    fd = None
    lock_file = None
    try:
        try:
            fd = os.open(path, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                    or stat.S_IMODE(info.st_mode) & 0o077):
                fail("OpenVPN PKI lock file is unsafe")
            os.fchmod(fd, 0o600)
            lock_file = os.fdopen(fd, "r+")
            fd = None
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        except OSError:
            fail("Unable to lock the OpenVPN PKI")
        with lock_file:
            yield
    finally:
        if fd is not None:
            os.close(fd)
        if lock_file is not None and not lock_file.closed:
            lock_file.close()


def openvpn_create_client(name):
    """Serialize Easy-RSA issuance with revocation for this PKI."""
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        fail("Invalid OpenVPN client name")
    if name in {"root", "server", "ca"}:
        fail("That OpenVPN client name is reserved")
    pki, _index = _openvpn_unique_pki(require_ca_key=True)
    with _openvpn_pki_lock(pki):
        return _openvpn_create_client_unlocked(name, pki)


def _openvpn_atomic_pki_file(path, content):
    directory = os.path.dirname(path)
    if not _safe_root_directory(directory):
        fail("OpenVPN PKI directory is unsafe")
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".iyke-openvpn-", dir=directory)
        os.fchmod(fd, 0o600)
        os.fchown(fd, 0, 0)
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, path)
        temporary = None
        dir_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except OSError:
        fail("Unable to update OpenVPN PKI files safely")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def _openvpn_run_easyrsa(easyrsa, pki, arguments):
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "EASYRSA_PKI": pki,
        "EASYRSA_BATCH": "1",
    }
    try:
        result = subprocess.run(
            [easyrsa, "--batch", *arguments], cwd=os.path.dirname(easyrsa),
            env=env, text=True, capture_output=True, check=False, timeout=90,
        )
    except (OSError, subprocess.SubprocessError):
        fail("Easy-RSA operation failed or timed out")
    if result.returncode != 0:
        fail("Easy-RSA operation failed")
    return result


def _openvpn_crl_contains_serial(crl_path, serial):
    """Require the generated CRL to contain the exact revoked certificate serial."""
    if not isinstance(serial, str) or not re.fullmatch(r"[0-9A-Fa-f]{1,64}", serial):
        return False
    crl_fd = _openvpn_trusted_file(crl_path, 4 * 1024 * 1024)
    openssl = shutil.which("openssl")
    if crl_fd is None or not openssl:
        if crl_fd is not None:
            os.close(crl_fd)
        return False
    try:
        result = subprocess.run(
            [openssl, "crl", "-in", f"/proc/self/fd/{crl_fd}", "-noout", "-text"],
            text=True, capture_output=True, check=False, timeout=10,
            pass_fds=(crl_fd,),
        )
        if result.returncode != 0:
            return False
        expected = serial.lstrip("0").upper() or "0"
        for value in re.findall(r"Serial Number:\s*(?:0x)?([0-9A-Fa-f:]+)", result.stdout):
            normalized = value.replace(":", "").lstrip("0").upper() or "0"
            if normalized == expected:
                return True
        return False
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        os.close(crl_fd)


def _openvpn_crl_signed_by_ca(crl_path, pki):
    """Verify the CRL signature against this PKI's trusted CA certificate."""
    crl_fd = _openvpn_trusted_file(crl_path, 4 * 1024 * 1024)
    ca_fd = _openvpn_trusted_file(os.path.join(pki, "ca.crt"), 1024 * 1024)
    if crl_fd is None or ca_fd is None:
        if crl_fd is not None:
            os.close(crl_fd)
        if ca_fd is not None:
            os.close(ca_fd)
        return False
    try:
        openssl = shutil.which("openssl")
        if not openssl:
            return False
        result = subprocess.run(
            [openssl, "crl", "-in", f"/proc/self/fd/{crl_fd}",
             "-CAfile", f"/proc/self/fd/{ca_fd}", "-noout", "-verify"],
            text=True, capture_output=True, check=False, timeout=10,
            pass_fds=(crl_fd, ca_fd),
        )
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        os.close(crl_fd)
        os.close(ca_fd)


def openvpn_revoke_client(name):
    """Revoke one verified client certificate and atomically publish a signed CRL."""
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        fail("Invalid OpenVPN client name")
    if name in {"root", "server", "ca"}:
        fail("That OpenVPN client name is reserved")
    pki, index_text = _openvpn_unique_pki(require_ca_key=True)
    cert_path = os.path.join(pki, "issued", name + ".crt")
    key_path = os.path.join(pki, "private", name + ".key")
    with _openvpn_pki_lock(pki):
        locked_pki, locked_index = _openvpn_unique_pki(require_ca_key=True)
        if os.path.realpath(locked_pki) != os.path.realpath(pki):
            fail("The trusted Easy-RSA database changed while acquiring its lock")
        pki = locked_pki
        index_text = locked_index
        if index_text is None:
            fail("Easy-RSA certificate database is unavailable or unsafe")
        records = _openvpn_index_clients(index_text)
        record = next((row for row in records if row["common_name"] == name), None)
        if record is None or record["status"] != "valid":
            fail("A valid, unrevoked client certificate was not found")
        if not _openvpn_certificate_is_client(cert_path):
            fail("Certificate is not verified for TLS client authentication")

        active_configs = []
        for config_path in _openvpn_server_config_paths():
            unit = ("openvpn-server@" if os.path.dirname(config_path) == "/etc/openvpn/server"
                    else "openvpn@") + os.path.basename(config_path)[:-5] + ".service"
            if _unit_state(unit) == "active" and _openvpn_runtime_config_matches(unit, config_path):
                active_configs.append(config_path)
        if len(active_configs) != 1:
            fail("Exactly one active OpenVPN server configuration must be verified before revocation")
        config_path = active_configs[0]
        crl_state = _openvpn_crl_state(config_path)
        if not crl_state.get("crl_configured") or not crl_state.get("crl_file_present"):
            fail("A valid CRL linked to the active server configuration is required before revocation")
        directives = _openvpn_config_directives(config_path)
        if not _openvpn_config_uses_pki_ca(config_path, directives, pki):
            fail("The active OpenVPN server must use the trusted Easy-RSA CA certificate")
        server_cert_value = _openvpn_single_directive(directives, "cert")
        if not server_cert_value:
            fail("The active server certificate path cannot be verified")
        server_cert_path = server_cert_value if os.path.isabs(server_cert_value) else os.path.join(
            os.path.dirname(config_path), server_cert_value
        )
        if os.path.realpath(server_cert_path) == os.path.realpath(cert_path):
            fail("Refusing to revoke the active OpenVPN server certificate")

        index_path = os.path.join(pki, "index.txt")
        crl_path = os.path.join(pki, "crl.pem")
        original_crl = _openvpn_read_pem(crl_path, "CRL")
        easyrsa = _openvpn_easyrsa_path()
        try:
            _openvpn_run_easyrsa(easyrsa, pki, ["revoke", name])
            updated_index = _read_openvpn_index(index_path)
            updated_record = next(
                (row for row in _openvpn_index_clients(updated_index or "")
                 if row["common_name"] == name), None
            )
            if updated_record is None or updated_record["status"] != "revoked":
                fail("Easy-RSA did not mark the requested certificate as revoked")
            _openvpn_run_easyrsa(easyrsa, pki, ["gen-crl"])
            _openvpn_read_pem(crl_path, "generated CRL")
            if not _openvpn_crl_state(config_path).get("crl_file_present"):
                fail("Generated CRL failed signature or active configuration verification")
            if not _openvpn_crl_contains_serial(crl_path, record["serial"]):
                fail("Generated CRL does not contain the revoked certificate serial")
        except SystemExit:
            try:
                _openvpn_atomic_pki_file(index_path, index_text)
                _openvpn_atomic_pki_file(crl_path, original_crl)
            except SystemExit:
                fail("Revocation failed and automatic PKI rollback also failed; manual recovery is required")
            raise
        return {"name": name, "revoked": True, "crl_regenerated": True,
                "server_reload_performed": False}


def _openvpn_server_config_paths():
    paths = []
    for directory in ("/etc/openvpn/server", "/etc/openvpn"):
        if not _safe_root_directory(directory):
            continue
        try:
            entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
        except OSError:
            continue
        for entry in entries:
            if entry.name.endswith(".conf") and entry.is_file(follow_symlinks=False):
                path = os.path.join(directory, entry.name)
                if _safe_root_directory(directory):
                    paths.append(path)
    return list(dict.fromkeys(paths))


def _openvpn_config_directives(config_path):
    fd = _openvpn_trusted_file(config_path, 1024 * 1024)
    if fd is None:
        fail("OpenVPN server configuration is missing or unsafe")
    try:
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            lines = source.read(1024 * 1024 + 1).splitlines()
    except (OSError, UnicodeDecodeError):
        fail("OpenVPN server configuration could not be read safely")
    finally:
        if fd >= 0:
            os.close(fd)
    directives = {}
    for raw in lines:
        line = raw.split("#", 1)[0].split(";", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        key = parts[0].lower()
        if key in {"port", "proto", "dev", "ca", "cert", "key", "tls-auth",
                   "tls-crypt", "tls-crypt-v2", "cipher", "data-ciphers",
                   "auth", "remote-cert-tls", "verify-client-cert"}:
            directives.setdefault(key, []).append(parts[1:])
    return directives


def _openvpn_read_pem(path, label, max_bytes=1024 * 1024):
    fd = _openvpn_trusted_file(path, max_bytes)
    if fd is None:
        fail("Required OpenVPN " + label + " file is missing or unsafe")
    try:
        with os.fdopen(fd, "r", encoding="ascii") as source:
            fd = -1
            value = source.read(max_bytes + 1)
    except (OSError, UnicodeDecodeError):
        fail("Required OpenVPN " + label + " file is invalid")
    finally:
        if fd >= 0:
            os.close(fd)
    if len(value) > max_bytes or not value.endswith("\n"):
        fail("Required OpenVPN " + label + " file is invalid")
    return value


def _openvpn_single_directive(directives, key, default=None):
    values = directives.get(key, [])
    if not values:
        return default
    if len(values) != 1 or len(values[0]) != 1 or not values[0][0]:
        fail("OpenVPN server configuration has an ambiguous " + key + " directive")
    return values[0][0]


def _openvpn_ca_cert_matches(config_ca_path, pki):
    """Compare trusted CA certificate identities, not their filesystem paths."""
    config_fd = _openvpn_trusted_file(config_ca_path, 1024 * 1024)
    pki_fd = _openvpn_trusted_file(os.path.join(pki, "ca.crt"), 1024 * 1024)
    if config_fd is None or pki_fd is None:
        if config_fd is not None:
            os.close(config_fd)
        if pki_fd is not None:
            os.close(pki_fd)
        return False
    try:
        openssl = shutil.which("openssl")
        if not openssl:
            return False
        der_values = []
        for fd in (config_fd, pki_fd):
            try:
                result = subprocess.run(
                    [openssl, "x509", "-in", f"/proc/self/fd/{fd}", "-outform", "DER"],
                    capture_output=True, check=False, timeout=10, pass_fds=(fd,),
                )
            except (OSError, subprocess.SubprocessError):
                return False
            if result.returncode != 0 or not result.stdout:
                return False
            der_values.append(result.stdout)
        return der_values[0] == der_values[1]
    finally:
        os.close(config_fd)
        os.close(pki_fd)


def _openvpn_config_uses_pki_ca(config_path, directives, pki):
    """Require the active server CA to be identical to the trusted Easy-RSA CA."""
    ca_value = _openvpn_single_directive(directives, "ca")
    if not ca_value:
        return False
    ca_path = ca_value if os.path.isabs(ca_value) else os.path.join(os.path.dirname(config_path), ca_value)
    return _openvpn_ca_cert_matches(os.path.abspath(ca_path), pki)



def _openvpn_certificate_is_client(cert_path):
    """Require the certificate's EKU to explicitly authorize TLS client authentication."""
    cert_fd = _openvpn_trusted_file(cert_path, 1024 * 1024)
    if cert_fd is None:
        return False
    try:
        openssl = shutil.which("openssl")
        if not openssl:
            return False
        result = subprocess.run(
            [openssl, "x509", "-in", f"/proc/self/fd/{cert_fd}",
             "-noout", "-ext", "extendedKeyUsage"],
            text=True, capture_output=True, check=False, timeout=10,
            pass_fds=(cert_fd,),
        )
        if result.returncode != 0:
            return False
        usage = result.stdout.lower()
        return "tls web client authentication" in usage or "clientauth" in usage
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        os.close(cert_fd)

def _openvpn_validate_profile_endpoint(name, endpoint):
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", name):
        fail("Invalid OpenVPN client name")
    if not isinstance(endpoint, str) or len(endpoint) > 253:
        fail("Enter this VPS public DNS name or IP address")
    endpoint = endpoint.strip().rstrip(".")
    try:
        address = ipaddress.ip_address(endpoint)
        if not address.is_global:
            fail("OpenVPN endpoint must be a public IP address or DNS name")
        return str(address)
    except ValueError:
        if "." not in endpoint or not re.fullmatch(
            r"(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*",
            endpoint
        ):
            fail("Enter a valid public DNS name or IP address")
        return endpoint


def openvpn_get_profile(name, endpoint):
    """Serialize profile reads with issuance/revocation and use the locked PKI snapshot."""
    endpoint = _openvpn_validate_profile_endpoint(name, endpoint)
    pki, _index = _openvpn_unique_pki()
    with _openvpn_pki_lock(pki):
        locked_pki, index_text = _openvpn_unique_pki()
        if os.path.realpath(locked_pki) != os.path.realpath(pki):
            fail("The trusted Easy-RSA database changed while acquiring its lock")
        return _openvpn_get_profile_unlocked(name, endpoint, locked_pki, index_text)


def _openvpn_get_profile_unlocked(name, endpoint, pki, index_text):
    """Build an inline client profile only for a narrowly validated server config."""
    records = _openvpn_index_clients(index_text)
    if not any(row["common_name"] == name and row["status"] == "valid" for row in records):
        fail("A valid client certificate for this name was not found")
    config_paths = _openvpn_server_config_paths()
    matching = []
    for path in config_paths:
        unit = ("openvpn-server@" if os.path.dirname(path) == "/etc/openvpn/server"
                else "openvpn@") + os.path.basename(path)[:-5] + ".service"
        if _unit_state(unit) != "active" or not _openvpn_runtime_config_matches(unit, path):
            continue
        directives = _openvpn_config_directives(path)
        matching.append((path, directives))
    if len(matching) != 1:
        fail("Exactly one active OpenVPN server configuration must be verified")
    config_path, directives = matching[0]
    if not _openvpn_config_uses_pki_ca(config_path, directives, pki):
        fail("The active OpenVPN server must use the trusted Easy-RSA CA certificate")

    port_text = _openvpn_single_directive(directives, "port", "1194")
    proto = _openvpn_single_directive(directives, "proto", "udp").lower()
    dev = _openvpn_single_directive(directives, "dev", "tun").lower()
    if not port_text.isdigit() or not 1 <= int(port_text) <= 65535:
        fail("OpenVPN server port is invalid")
    if proto not in {"udp", "udp4", "udp6", "tcp", "tcp4", "tcp6", "tcp-server"}:
        fail("This OpenVPN transport is not supported for profile generation")
    if dev not in {"tun", "tun0"}:
        fail("Only tun-mode OpenVPN server configurations are supported")
    if _openvpn_single_directive(directives, "verify-client-cert", "1").lower() in {"none", "optional"}:
        fail("Server configuration does not require client certificates")

    base = os.path.dirname(config_path)
    def config_file(key, fallback):
        value = _openvpn_single_directive(directives, key, fallback)
        path = value if os.path.isabs(value) else os.path.join(base, value)
        return os.path.abspath(path)

    ca_path = config_file("ca", os.path.join(pki, "ca.crt"))
    cert_path = os.path.join(pki, "issued", name + ".crt")
    if not _openvpn_certificate_is_client(cert_path):
        fail("Certificate is not verified for TLS client authentication")
    key_path = os.path.join(pki, "private", name + ".key")
    ca = _openvpn_read_pem(ca_path, "CA certificate")
    cert = _openvpn_read_pem(cert_path, "client certificate")
    key_fd = _openvpn_trusted_file(key_path, 1024 * 1024)
    if key_fd is None:
        fail("OpenVPN client private key is missing or unsafe")
    key_info = os.fstat(key_fd)
    os.close(key_fd)
    if stat.S_IMODE(key_info.st_mode) & 0o077:
        fail("OpenVPN client private key must be accessible only to root")
    key = _openvpn_read_pem(key_path, "client private key")
    if "PRIVATE KEY-----" not in key or "BEGIN CERTIFICATE" not in cert or "BEGIN CERTIFICATE" not in ca:
        fail("OpenVPN certificate material is not in the expected PEM format")

    profile = [
        "client", "dev tun", "proto " + ("tcp-client" if proto.startswith("tcp") else "udp"),
        "remote " + endpoint + " " + port_text, "resolv-retry infinite",
        "nobind", "persist-key", "persist-tun", "remote-cert-tls server",
        "verb 3", "auth-nocache", "<ca>", ca.rstrip(), "</ca>",
        "<cert>", cert.rstrip(), "</cert>", "<key>", key.rstrip(), "</key>",
    ]
    tls_crypt = directives.get("tls-crypt", [])
    tls_auth = directives.get("tls-auth", [])
    tls_crypt_v2 = directives.get("tls-crypt-v2", [])
    if sum(bool(x) for x in (tls_crypt, tls_auth, tls_crypt_v2)) > 1:
        fail("Server configuration has conflicting TLS key modes")
    if tls_crypt_v2:
        fail("tls-crypt-v2 client profiles are not supported yet")
    if tls_crypt:
        if len(tls_crypt) != 1 or len(tls_crypt[0]) not in {1, 2}:
            fail("OpenVPN tls-crypt directive is ambiguous")
        tls_path = tls_crypt[0][0]
        tls_path = tls_path if os.path.isabs(tls_path) else os.path.join(base, tls_path)
        tls_data = _openvpn_read_pem(os.path.abspath(tls_path), "tls-crypt key")
        profile.extend(["<tls-crypt>", tls_data.rstrip(), "</tls-crypt>"])
    if tls_auth:
        if len(tls_auth) != 1 or len(tls_auth[0]) not in {1, 2}:
            fail("OpenVPN tls-auth directive is ambiguous")
        tls_path = tls_auth[0][0]
        tls_path = tls_path if os.path.isabs(tls_path) else os.path.join(base, tls_path)
        tls_data = _openvpn_read_pem(os.path.abspath(tls_path), "tls-auth key")
        direction = tls_auth[0][1] if len(tls_auth[0]) == 2 else None
        if direction is not None and direction not in {"0", "1"}:
            fail("OpenVPN tls-auth direction is invalid")
        profile.extend(["<tls-auth>", tls_data.rstrip(), "</tls-auth>"])
        # OpenVPN's default is bidirectional when the server omits key-direction.
        # Only emit the inverse when the server explicitly configures a direction.
        if direction is not None:
            profile.append("key-direction " + ("1" if direction == "0" else "0"))
    for key_name in ("cipher", "auth"):
        value = _openvpn_single_directive(directives, key_name)
        if value and re.fullmatch(r"[A-Za-z0-9_-]{1,64}", value):
            profile.append(key_name + " " + value)
    ciphers = directives.get("data-ciphers", [])
    if ciphers:
        if len(ciphers) != 1 or len(ciphers[0]) != 1 or not re.fullmatch(r"[A-Za-z0-9_:-]{1,256}", ciphers[0][0]):
            fail("OpenVPN data-ciphers directive is ambiguous")
        profile.append("data-ciphers " + ciphers[0][0])
    return {"profile": "\n".join(profile) + "\n", "name": name}

def openvpn_clients():
    """Discover a trusted Easy-RSA PKI and return certificate index metadata only."""
    candidates = []
    seen = set()
    for path in _openvpn_pki_candidates():
        normalized = os.path.normpath(path)
        if normalized in seen:
            continue
        seen.add(normalized)
        if not _safe_root_directory(normalized):
            continue
        if not _safe_root_directory(os.path.join(normalized, "issued")):
            continue
        if not _safe_root_directory(os.path.join(normalized, "private")):
            continue
        index = _read_openvpn_index(os.path.join(normalized, "index.txt"))
        if index is not None:
            candidates.append((normalized, index))
    if len(candidates) != 1:
        return {"available": False, "reason": (
            "No trusted Easy-RSA database found" if not candidates
            else "More than one Easy-RSA database found; configure one explicitly"
        ), "clients": []}
    _path, index_text = candidates[0]
    return {"available": True, "reason": "", "clients": _openvpn_index_clients(index_text)}

def _openvpn_trusted_file(path, max_bytes=4 * 1024 * 1024):
    """Open a root-owned, non-writable, single-link regular file without following links."""
    if not _safe_root_directory(os.path.dirname(os.path.abspath(path))):
        return None
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) & 0o022 or info.st_size > max_bytes):
            os.close(fd)
            return None
        return fd
    except OSError:
        return None


def _openvpn_crl_state(config_path):
    """Validate one CRL against the CA in the uniquely matching trusted Easy-RSA PKI."""
    unavailable = {"crl_configured": False, "crl_file_present": False}
    if not _safe_root_directory(os.path.dirname(os.path.abspath(config_path))):
        return unavailable
    config_fd = None
    try:
        config_fd = _openvpn_trusted_file(config_path, 1024 * 1024)
        if config_fd is None:
            return unavailable
        with os.fdopen(config_fd, "r", encoding="utf-8") as source:
            config_fd = None
            lines = source.read(1024 * 1024 + 1).splitlines()
    except (OSError, UnicodeDecodeError):
        return unavailable
    finally:
        if config_fd is not None:
            os.close(config_fd)

    directives = []
    ca_directives = []
    for line in lines:
        directive = line.split("#", 1)[0].strip()
        match = re.match(r"^crl-verify\s+(\S+)(?:\s+.*)?$", directive)
        if match:
            directives.append(match.group(1).strip("\\\"'"))
        ca_match = re.match(r"^ca\s+(\S+)(?:\s+.*)?$", directive)
        if ca_match:
            ca_directives.append(ca_match.group(1).strip("\\\"'"))
    if not directives:
        return unavailable
    if len(directives) != 1 or not directives[0]:
        return {"crl_configured": True, "crl_file_present": False}
    if len(ca_directives) != 1 or not ca_directives[0]:
        return {"crl_configured": True, "crl_file_present": False}

    crl_path = directives[0]
    if not os.path.isabs(crl_path):
        crl_path = os.path.join(os.path.dirname(config_path), crl_path)
    crl_path = os.path.abspath(crl_path)

    matching_pkis = []
    for candidate in dict.fromkeys(os.path.normpath(p) for p in _openvpn_pki_candidates()):
        if not _safe_root_directory(candidate):
            continue
        if not _safe_root_directory(os.path.join(candidate, "issued")):
            continue
        if not _safe_root_directory(os.path.join(candidate, "private")):
            continue
        if crl_path == os.path.join(candidate, "crl.pem"):
            matching_pkis.append(candidate)
    if len(matching_pkis) != 1:
        return {"crl_configured": True, "crl_file_present": False}

    pki = matching_pkis[0]
    ca_path = ca_directives[0]
    if not os.path.isabs(ca_path):
        ca_path = os.path.join(os.path.dirname(config_path), ca_path)
    if not _openvpn_ca_cert_matches(os.path.abspath(ca_path), pki):
        return {"crl_configured": True, "crl_file_present": False}
    crl_fd = _openvpn_trusted_file(os.path.join(pki, "crl.pem"))
    ca_fd = _openvpn_trusted_file(os.path.join(pki, "ca.crt"))
    if crl_fd is None or ca_fd is None:
        if crl_fd is not None:
            os.close(crl_fd)
        if ca_fd is not None:
            os.close(ca_fd)
        return {"crl_configured": True, "crl_file_present": False}

    valid = False
    try:
        openssl = shutil.which("openssl")
        if openssl:
            result = subprocess.run(
                [openssl, "crl", "-in", f"/proc/self/fd/{crl_fd}",
                 "-CAfile", f"/proc/self/fd/{ca_fd}", "-noout", "-verify"],
                text=True, capture_output=True, check=False, timeout=10,
                pass_fds=(crl_fd, ca_fd),
            )
            valid = result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        valid = False
    finally:
        os.close(crl_fd)
        os.close(ca_fd)
    return {"crl_configured": True, "crl_file_present": valid}


def _openvpn_runtime_config_matches(unit, expected_config):
    """Require the active MainPID to be OpenVPN itself and pass exactly this config."""
    if not re.fullmatch(r"openvpn(?:-server)?@[A-Za-z0-9_.-]{1,64}\.service", unit):
        return False
    if _unit_state(unit) != "active":
        return False
    try:
        first = subprocess.run(
            ["systemctl", "show", unit, "--property=MainPID", "--value"],
            text=True, capture_output=True, check=False, timeout=5,
        )
        if first.returncode != 0 or not re.fullmatch(r"[1-9][0-9]{0,8}", first.stdout.strip()):
            return False
        pid = first.stdout.strip()
        with open(f"/proc/{pid}/cmdline", "rb") as source:
            raw = source.read(65537)
        if not raw or len(raw) > 65536 or not raw.endswith(b"\0"):
            return False
        argv = [part.decode("utf-8", "strict") for part in raw.rstrip(b"\0").split(b"\0")]
        if not argv:
            return False
        process_exe = os.readlink(f"/proc/{pid}/exe")
        expected_exe = shutil.which("openvpn")
        if not expected_exe or os.path.realpath(process_exe) != os.path.realpath(expected_exe):
            return False
        configs = []
        index = 1
        while index < len(argv):
            arg = argv[index]
            if arg == "--config":
                if index + 1 >= len(argv):
                    return False
                configs.append(argv[index + 1])
                index += 2
                continue
            if arg.startswith("--config="):
                configs.append(arg.split("=", 1)[1])
            index += 1
        if len(configs) != 1 or not configs[0] or not os.path.isabs(configs[0]):
            return False
        if os.path.normpath(configs[0]) != os.path.normpath(expected_config):
            return False
        second = subprocess.run(
            ["systemctl", "show", unit, "--property=MainPID", "--value"],
            text=True, capture_output=True, check=False, timeout=5,
        )
        return second.returncode == 0 and second.stdout.strip() == pid
    except (OSError, UnicodeError, subprocess.SubprocessError):
        return False


def vpn_status():
    """Return service metadata only; never expose private keys or config contents."""
    wireguard_installed = shutil.which("wg") is not None
    wireguard = {"installed": wireguard_installed, "interfaces": []}
    if wireguard_installed:
        try:
            result = subprocess.run(["wg", "show", "interfaces"], text=True,
                                    capture_output=True, check=False, timeout=5)
            if result.returncode == 0:
                for interface in result.stdout.split():
                    if re.fullmatch(r"[A-Za-z0-9_=+.-]{1,15}", interface):
                        wireguard["interfaces"].append({
                            "name": interface,
                            "status": "active"
                        })
        except (OSError, subprocess.TimeoutExpired):
            pass

    openvpn_installed = shutil.which("openvpn") is not None
    openvpn = {"installed": openvpn_installed, "instances": []}
    if openvpn_installed:
        for directory, unit_prefix in (
            ("/etc/openvpn/server", "openvpn-server@"),
            ("/etc/openvpn", "openvpn@"),
        ):
            try:
                entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
            except OSError:
                continue
            for entry in entries:
                if (not entry.name.endswith(".conf")
                        or not entry.is_file(follow_symlinks=False)):
                    continue
                instance = entry.name[:-5]
                if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", instance):
                    continue
                config_path = os.path.join(directory, entry.name)
                unit = f"{unit_prefix}{instance}.service"
                crl_state = _openvpn_crl_state(config_path)
                runtime_verified = _openvpn_runtime_config_matches(unit, config_path)
                openvpn["instances"].append({
                    "name": instance,
                    "status": _unit_state(unit),
                    "crl_runtime_verified": bool(
                        runtime_verified and crl_state["crl_configured"]
                        and crl_state["crl_file_present"]
                    ),
                    **crl_state,
                })
    xray_binary = shutil.which("xray")
    xray = {
        "installed": xray_binary is not None,
        "service": _unit_state("xray.service") if xray_binary else "not-installed",
        "config_status": "unavailable",
        "inbounds": [],
        "public_hostname": "",
    }
    if xray_binary:
        xray.update(_xray_config_summary())
        xray["public_hostname"] = _caddy_public_hostname()
    hysteria_binary = shutil.which("hysteria")
    hysteria = {
        "installed": hysteria_binary is not None,
        "service": _unit_state("hysteria-server.service") if hysteria_binary else "not-installed",
        "config_status": "present" if os.path.isfile("/etc/hysteria/config.yaml") else "missing",
    }
    return {"wireguard": wireguard, "openvpn": openvpn, "xray": xray,
            "hysteria": hysteria}




def _secure_wireguard_dir():
    directory = "/etc/wireguard"
    try:
        os.mkdir(directory, 0o700)
    except FileExistsError:
        pass
    try:
        info = os.lstat(directory)
    except OSError:
        fail("WireGuard configuration directory is unavailable")
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
        fail("WireGuard configuration directory has unsafe ownership or type")
    os.chmod(directory, 0o700)
    return directory


def _atomic_secret_file(path, content, mode=0o600):
    directory = os.path.dirname(path)
    fd = None
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".iyke-wg-", dir=directory)
        os.fchmod(fd, mode)
        os.fchown(fd, 0, 0)
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            fd = None
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, path)
        temporary = None
        dir_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except OSError:
        fail("Unable to write WireGuard configuration securely")
    finally:
        if fd is not None:
            os.close(fd)
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def _run_apt_task(apt_get, arguments, task):
    """Run a fixed APT task in a transient system service outside the web sandbox."""
    systemd_run = shutil.which("systemd-run")
    if not systemd_run:
        fail("systemd-run is unavailable; cannot safely install WireGuard from the panel")
    unit = f"iyke-vps-manager-apt-{task}-{os.getpid()}-{os.urandom(4).hex()}"
    command = [
        systemd_run, "--quiet", "--wait", "--pipe", "--collect",
        f"--unit={unit}", "--property=RuntimeMaxSec=240",
        "--setenv=DEBIAN_FRONTEND=noninteractive",
        apt_get, *arguments,
    ]
    try:
        subprocess.run(command, text=True, capture_output=True, check=True, timeout=270)
    except subprocess.TimeoutExpired:
        fail(f"WireGuard package {task} timed out")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "APT task failed").strip()
        fail(f"WireGuard package {task} failed: {detail[-500:]}")


def wireguard_install():
    """Install WireGuard and create a private server config; do not alter firewall or start it."""
    if not os.path.exists("/etc/os-release"):
        fail("WireGuard installation supports Ubuntu and Debian only")
    try:
        with open("/etc/os-release", encoding="utf-8") as source:
            os_release = source.read()
    except OSError:
        fail("Unable to identify this operating system")
    if not re.search(r'^ID=(ubuntu|debian)$', os_release, re.MULTILINE):
        fail("WireGuard installation supports Ubuntu and Debian only")
    directory = "/etc/wireguard"
    if os.path.lexists(os.path.join(directory, "wg0.conf")):
        fail("A wg0.conf already exists; refusing to overwrite it")
    _secure_wireguard_dir()
    apt_get = shutil.which("apt-get")
    if not apt_get:
        fail("APT package manager is unavailable")
    _run_apt_task(apt_get, ["update"], "update")
    _run_apt_task(apt_get, ["install", "-y", "wireguard"], "install")
    if not shutil.which("wg"):
        fail("WireGuard installation did not provide the wg command")
    private_key = run(["wg", "genkey"])
    if not re.fullmatch(r"[A-Za-z0-9+/]{43}=", private_key):
        fail("WireGuard generated an invalid server key")
    public_key = run(["wg", "pubkey"], private_key + "\n")
    if not re.fullmatch(r"[A-Za-z0-9+/]{43}=", public_key):
        fail("WireGuard generated an invalid public key")
    config = ("# Managed by Iyke VPS Manager; do not edit manually.\n"
              "[Interface]\n"
              "Address = 10.66.0.1/24\n"
              "ListenPort = 51820\n"
              f"PrivateKey = {private_key}\n")
    _atomic_secret_file(os.path.join(directory, "wg0.conf"), config, 0o600)
    _atomic_secret_file(os.path.join(directory, "server.pub"), public_key + "\n", 0o644)
    return {"installed": True, "interface": "wg0", "public_key": public_key,
            "service": "inactive", "firewall_changed": False}


def wireguard_public_endpoint():
    """Discover this VPS public IPv4 address for client endpoint configuration."""
    try:
        request = urllib.request.Request(
            "https://api.ipify.org",
            headers={"User-Agent": "Iyke-VPS-Manager/1.0"},
        )
        with urllib.request.urlopen(request, timeout=5) as response:
            raw = response.read(64).decode("ascii").strip()
        address = ipaddress.ip_address(raw)
    except (OSError, UnicodeDecodeError, ValueError):
        fail("Unable to detect this VPS public IP; enter its public IP or DNS name manually")
    if not isinstance(address, ipaddress.IPv4Address) or not address.is_global:
        fail("The detected address is not a public IPv4 address; enter the VPS public IP or DNS name manually")
    return {"host": str(address), "port": 51820, "endpoint": f"{address}:51820"}


def wireguard_service(state):
    if state not in {"start", "stop"}:
        fail("Invalid WireGuard service state")
    config = "/etc/wireguard/wg0.conf"
    try:
        info = os.lstat(config)
    except OSError:
        fail("Install and configure WireGuard before controlling the service")
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o077:
        fail("WireGuard server configuration has unsafe ownership or permissions")
    if state == "start":
        run(["systemctl", "start", "wg-quick@wg0.service"])
    else:
        run(["systemctl", "stop", "wg-quick@wg0.service"])
    return {"interface": "wg0", "requested_state": state}



WG_NAME = re.compile(r"^[a-z][a-z0-9_-]{0,30}$")
WG_KEY = re.compile(r"^[A-Za-z0-9+/]{43}=$")
WG_SUBNET = "10.66.0.0/24"


def _read_root_file(path, mode_mask=0o077):
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        fail("Required WireGuard file is unavailable")
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & mode_mask):
            fail("WireGuard file has unsafe ownership or permissions")
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            fd = -1
            return source.read()
    except (OSError, UnicodeDecodeError):
        fail("Unable to read WireGuard file securely")
    finally:
        if fd >= 0:
            os.close(fd)


@contextmanager
def _wireguard_peer_lock():
    directory = _secure_wireguard_dir()
    path = os.path.join(directory, "peers.lock")
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    fd = None
    try:
        fd = os.open(path, flags, 0o600)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            fail("WireGuard peer lock file is unsafe")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "r+") as lock_file:
            fd = None
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            yield
    except OSError:
        fail("Unable to lock WireGuard peer registry")
    finally:
        if fd is not None:
            os.close(fd)


def _peer_registry():
    directory = _secure_wireguard_dir()
    path = os.path.join(directory, "peers.json")
    if not os.path.lexists(path):
        return {}
    raw = _read_root_file(path)
    try:
        peers = json.loads(raw)
    except json.JSONDecodeError:
        fail("WireGuard peer registry is corrupted")
    if not isinstance(peers, dict):
        fail("WireGuard peer registry is invalid")
    for name, peer in peers.items():
        if (not isinstance(name, str) or not WG_NAME.fullmatch(name)
                or name in {"root", "server"} or not isinstance(peer, dict)
                or set(peer) != {"public_key", "address", "endpoint"}):
            fail("WireGuard peer registry contains invalid data")
        if not isinstance(peer["public_key"], str) or not WG_KEY.fullmatch(peer["public_key"]):
            fail("WireGuard peer registry contains an invalid key")
        try:
            address = ipaddress.ip_interface(peer["address"])
        except (ValueError, TypeError):
            fail("WireGuard peer registry contains an invalid address")
        if address.network.prefixlen != 32 or address.ip not in ipaddress.ip_network(WG_SUBNET):
            fail("WireGuard peer registry contains an out-of-range address")
        if not isinstance(peer["endpoint"], str) or not _valid_endpoint(peer["endpoint"]):
            fail("WireGuard peer registry contains an invalid endpoint")
    return peers


def _save_peer_registry(peers):
    path = os.path.join(_secure_wireguard_dir(), "peers.json")
    _atomic_secret_file(path, json.dumps(peers, sort_keys=True, separators=(",", ":")) + "\n", 0o600)


def _valid_endpoint(value):
    if not isinstance(value, str) or len(value) > 255 or value.count(":") < 1:
        return False
    host, separator, port_text = value.rpartition(":")
    if not separator or not port_text.isdigit() or not 1 <= int(port_text) <= 65535:
        return False
    if not host or any(ch.isspace() for ch in host) or "/" in host or "\\" in host:
        return False
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return bool(re.fullmatch(
            r"(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*",
            host
        ))


def _check_wg_config():
    _secure_wireguard_dir()
    path = "/etc/wireguard/wg0.conf"
    config = _read_root_file(path)
    if (not config.startswith("# Managed by Iyke VPS Manager; do not edit manually.\n")
            or len(re.findall(r"(?m)^\[Interface\]$", config)) != 1
            or len(re.findall(r"(?m)^ListenPort\s*=\s*(\d+)\s*$", config)) != 1
            or len(re.findall(r"(?m)^PrivateKey\s*=", config)) != 1):
        fail("WireGuard configuration is not managed by Iyke VPS Manager; refusing to modify it")
    if not shutil.which("wg"):
        fail("WireGuard is not installed")
    return config


def _wg_active():
    result = subprocess.run(["wg", "show", "wg0"], text=True, capture_output=True,
                            check=False, timeout=10)
    return result.returncode == 0


def _peer_config_text(config, peers):
    base = re.split(r"(?m)^# Iyke peer: [a-z][a-z0-9_-]{0,30}\n", config, maxsplit=1)[0].rstrip()
    blocks = []
    for name in sorted(peers):
        peer = peers[name]
        blocks.append(f"# Iyke peer: {name}\n[Peer]\nPublicKey = {peer['public_key']}\nAllowedIPs = {peer['address']}\n")
    return base + ("\n\n" + "\n".join(blocks) if blocks else "") + "\n"


def _allocate_peer_address(peers):
    used = {str(ipaddress.ip_interface(peer["address"]).ip) for peer in peers.values()}
    for host in range(2, 255):
        candidate = f"10.66.0.{host}"
        if candidate not in used:
            return candidate + "/32"
    fail("The WireGuard client address pool is full")


def _valid_peer_name(name):
    if not isinstance(name, str) or not WG_NAME.fullmatch(name) or name in {"root", "server"}:
        fail("Client name must use lowercase letters, numbers, hyphens or underscores")
    return name


def wireguard_list_peers():
    _check_wg_config()
    peers = _peer_registry()
    return [{"name": name, "address": peers[name]["address"], "endpoint": peers[name]["endpoint"]}
            for name in sorted(peers)]


def _wireguard_create_peer_unlocked(name, endpoint):
    name = _valid_peer_name(name)
    if not _valid_endpoint(endpoint):
        fail("Endpoint must be a public IP address or hostname followed by :port")
    config = _check_wg_config()
    listen_ports = re.findall(r"(?m)^ListenPort\s*=\s*(\d+)\s*$", config)
    endpoint_port = int(endpoint.rpartition(":")[2])
    if not listen_ports or endpoint_port != int(listen_ports[0]):
        fail("Client endpoint port must match the server WireGuard ListenPort")
    peers = _peer_registry()
    if name in peers:
        fail("A WireGuard client with that name already exists")
    address = _allocate_peer_address(peers)
    private_key = run(["wg", "genkey"])
    if not WG_KEY.fullmatch(private_key):
        fail("WireGuard generated an invalid client key")
    public_key = run(["wg", "pubkey"], private_key + "\n")
    if not WG_KEY.fullmatch(public_key):
        fail("WireGuard generated an invalid client public key")
    server_public = _read_root_file("/etc/wireguard/server.pub", mode_mask=0).strip()
    if not WG_KEY.fullmatch(server_public):
        fail("WireGuard server public key is invalid")
    client_config = (
        "[Interface]\n"
        f"PrivateKey = {private_key}\n"
        f"Address = {address}\n"
        "DNS = 1.1.1.1\n\n"
        "[Peer]\n"
        f"PublicKey = {server_public}\n"
        f"Endpoint = {endpoint}\n"
        f"AllowedIPs = {WG_SUBNET}\n"
        "PersistentKeepalive = 25\n"
    )
    updated = dict(peers)
    updated[name] = {"public_key": public_key, "address": address, "endpoint": endpoint}
    directory = _secure_wireguard_dir()
    clients_dir = os.path.join(directory, "clients")
    try:
        os.mkdir(clients_dir, 0o700)
    except FileExistsError:
        pass
    client_info = os.lstat(clients_dir)
    if not stat.S_ISDIR(client_info.st_mode) or client_info.st_uid != 0:
        fail("WireGuard client profile directory is unsafe")
    os.chmod(clients_dir, 0o700)
    profile_path = os.path.join(clients_dir, name + ".conf")
    if os.path.lexists(profile_path):
        fail("A client profile file already exists; refusing to overwrite it")
    active = _wg_active()
    _atomic_secret_file(profile_path, client_config, 0o600)
    try:
        _atomic_secret_file(os.path.join(directory, "wg0.conf"),
                            _peer_config_text(config, updated), 0o600)
        _save_peer_registry(updated)
        if active:
            run(["wg", "set", "wg0", "peer", public_key, "allowed-ips", address])
    except SystemExit:
        _atomic_secret_file(os.path.join(directory, "wg0.conf"), config, 0o600)
        try:
            os.unlink(profile_path)
        except OSError:
            pass
        _save_peer_registry(peers)
        if active:
            try:
                run(["wg", "set", "wg0", "peer", public_key, "remove"])
            except SystemExit:
                pass
        raise
