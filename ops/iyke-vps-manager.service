[Unit]
Description=Iyke VPS Manager
After=network.target
Wants=network.target

[Service]
Type=simple
User=iyke-vps-manager
Group=iyke-vps-manager
WorkingDirectory=/opt/iyke-vps-manager
EnvironmentFile=/etc/iyke-vps-manager/manager.env
ExecStart=/opt/iyke-vps-manager/venv/bin/gunicorn --preload --workers 2 --threads 4 --bind 127.0.0.1:8787 --timeout 30 run:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/etc /home /var/log /var/mail /var/spool /var/lib/iyke-vps-manager
UMask=0077
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
